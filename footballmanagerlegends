function crest(t,z=30){const im=t.img||CRESTS[t.n];if(im)return `<img src="${im}" width="${z}" height="${z*1.15}" style="object-fit:contain" alt="${t.n}">`;const i=t.n.replace(/[^A-Za-zÀ-ú]/g,"").slice(0,3).toUpperCase();return `<svg width="${z}" height="${z*1.15}" viewBox="0 0 24 28"><path d="M2 2h20v14c0 6-6 9-10 11C8 25 2 22 2 16z" fill="${t.c1}" stroke="${t.c2}" stroke-width="2"/><text x="12" y="17" text-anchor="middle" font-size="8" font-weight="800" fill="${t.c2}">${i}</text></svg>`}
