function rarity(){let x=Math.random()*100;for(let i=0;i<6;i++){if(x<RW[i])return i;x-=RW[i]}return 0}
function openPack(){if(S.coins<PACKCOST){alert("Moedas insuficientes.");return}S.coins-=PACKCOST;const r=rarity(),c=LG.filter(l=>l[3]==pk&&l[4]==r),l=pick(c),card={cid:S.cn++,id:LG.indexOf(l)};S.cards.push(card);reveal=card;save();render()}
function useCard(cid){const me=S.T[S.me],c=S.cards.find(x=>x.cid==cid);if(!c)return;if(me.pl.length>=32){alert("Elenco cheio (máx. 32). Venda ou libere alguém antes.");return}const l=LG[c.id];me.pl.push({id:uid++,n:l[0]+" ("+(l[3]=="98"?"1998":"2006")+")",pos:l[1],o:l[2],age:28,v:0,w:0,g:0,leg:c.id});S.cards=S.cards.filter(x=>x.cid!=cid);if(reveal&&reveal.cid==cid)reveal=null;S.news.unshift("Lenda no elenco: "+l[0]+" ("+l[2]+"). Ele entra como reserva; ajuste na aba Elenco.");save();render()}
function stash(id){const me=S.T[S.me],p=me.pl.find(x=>x.id==id);if(!p||p.leg===undefined)return;if(me.pl.length<=18){alert("Mínimo de 18 jogadores.");return}me.pl=me.pl.filter(x=>x.id!=id);S.cards.push({cid:S.cn++,id:p.leg});auto(me);save();render()}
function sellCard(cid){const c=S.cards.find(x=>x.cid==cid);S.coins+=RV[LG[c.id][4]];S.cards=S.cards.filter(x=>x.cid!=cid);if(reveal&&reveal.cid==cid)reveal=null;save();render()}
function cardH(c){const l=LG[c.id];return `<div class="card r${l[4]}"><div class="mut" style="font-size:11px">${RN[l[4]]} · Copa ${l[3]=="98"?"1998":"2006"}</div><div class="big">${l[2]}</div><b>${l[0]}</b><div class="mut">${POS[l[1]]}</div></div>`}
function sav(n){return has(n)}
function upCrest(el){const f=el.files[0];if(!f)return;const im=new Image();im.onload=()=>{const c=document.createElement("canvas");c.width=c.height=64;const x=c.getContext("2d"),k=Math.min(64/im.width,64/im.height);x.drawImage(im,(64-im.width*k)/2,(64-im.height*k)/2,im.width*k,im.height*k);S.T[+$("#cs").value].img=c.toDataURL("image/png");save();render()};im.src=URL.createObjectURL(f)}
function impPl(){try{const j=JSON.parse($("#pj").value);let n=0;Object.keys(j).forEach(k=>{const t=S.T.find(x=>x.n==k);if(!t)return;const a=j[k];if(a.length<18||a.filter(p=>p.pos=="GK").length<2)return;t.pl=a.map(p=>{const o=Math.max(40,Math.min(99,+p.o||60)),v=Math.round(Math.pow(o/10,4)/100*10)/10;return{id:uid++,n:String(p.n).slice(0,30),pos:["GK","DEF","MID","ATT"].includes(p.pos)?p.pos:"MID",o,age:+p.age||25,v,w:Math.round(v*15)/10000,g:0}});auto(t);n++});save();alert(n+" elenco(s) importado(s).");render()}catch(e){alert("JSON inválido.")}}
function delSlot(n){if(confirm("Excluir o save "+n+"? Esta ação não pode ser desfeita.")){localStorage.removeItem(key(n));render()}}
function doExp(){expo=JSON.stringify(S);render()}
function doImp(){try{const s=JSON.parse($("#imp").value);if(!s.T||!s.cups)throw 0;S=s;S.slot=S.slot||1;save();tab="home";render()}catch(e){alert("JSON inválido.")}}
function startScr(){let h=`<div class="hero"><h1>⚽ Football Legends Manager</h1><div class="mut">Escolha seu clube. Dados de exemplo fictícios, sem licença oficial.</div></div>`;for(let n=1;n<=3;n++)if(has(n))h+=`<div class="c"><button onclick="load(${n})">Continuar carreira (save ${n})</button></div>`;[0,1].forEach(d=>{h+='<div class="c"><h3>Série '+(d?"B":"A")+'</h3><div class="grid">'+CL.map((c,i)=>(i<20?0:1)!=d?"":`<div class="club" onclick="newGame(${i},1)">${crest(newTeamLite(c),44)}<b>${c[0]}</b><small>Força ${c[3]}</small></div>`).join("")+'</div></div>'});$("#app").innerHTML=h;$("#nav").innerHTML=""}
function newTeamLite(c){return{n:c[0],c1:c[1],c2:c[2]}}
function render(){if(!S)return startScr();const me=S.T[S.me],tb=tbl(S.T[S.me].d),pos=tb.findIndex(x=>x.i==S.me)+1;let h=`<div class="top">${crest(me,24)}<b>${me.n} <small class="mut">Série ${me.d?"B":"A"}</small></b><span class="pill">${fm(S.money)}</span><span class="pill">🪙 ${S.coins}</span></div>`;
if(tab=="home"){const f=nextFx(),done=S.round>=38;h+=`<div class="c"><h2>Temporada ${S.season}</h2>`;if(done){const ch=S.T[tb[0].i];h+=`<div class="big">${crest(ch,36)}</div><p>Campeão da Série ${me.d?"B":"A"}: <b>${ch.n}</b>. Você terminou em ${pos}º.</p><button onclick="newSeason()">Nova temporada</button>`}else{const o=S.T[f[0]==S.me?f[1]:f[0]];h+=`<div class="mut">Rodada ${S.round+1}/38 · ${f[0]==S.me?"em casa":"fora"}</div><div class="row"><span>${crest(me)}</span><b class="n">${me.n}</b><span>${str(me).toFixed(1)}</span></div><div class="row"><span>${crest(o)}</span><b class="n">${o.n}</b><span>${str(o).toFixed(1)}</span></div>${pend()?`<div style="margin:10px 0;padding:10px;border:1px solid var(--gold);border-radius:12px"><b>🏆 ${pend().n}: sua equipe joga agora!</b><br><button onclick="playCup()" style="margin-top:8px">Jogar partida da copa</button></div>`:""}<p><button onclick="step();render()">Simular rodada</button> <button class="s" onclick="for(let i=0;i<5&&!pend();i++)step();render()">+5 rodadas</button> <button class="s" onclick="while(S.round<38&&!pend())step();render()">Temporada</button></p>`}h+=`</div><div class="c"><h3>Diretoria</h3>Objetivo: ${me.d?"acesso (top 4)":"G6"}. Posição: <b>${pos}º</b> (${pos<=(me.d?4:6)?"dentro":"fora"} da meta).</div>`;if(S.last){const r=S.last;h+=`<div class="c"><h3>Último jogo</h3><div class="big">${S.T[r.hi].n} ${r.hg} x ${r.ag} ${S.T[r.ai].n}</div><small class="mut">Posse ${r.pos}%–${100-r.pos}% · Chutes ${r.sh[0]}–${r.sh[1]}</small>${r.ev.map(e=>`<div>${e.m} min ⚽ ${e.n} <span class="mut">(${e.s=="h"?S.T[r.hi].n:S.T[r.ai].n})</span></div>`).join("")||"<div class='mut'>Sem gols.</div>"}</div>`}h+=`<div class="c"><h3>Notícias</h3>${S.news.map(n=>`<div class="row">${n}</div>`).join("")}</div>`;if(S.hist.length)h+=`<div class="c"><h3>Hall da Fama</h3>${S.hist.join("<br>")}</div>`}
else if(tab=="sq"){h+=`<div class="c"><select onchange="setF(this.value)">${Object.keys(FM).map(f=>`<option ${f==me.form?"selected":""}>${f}</option>`).join("")}</select> <select onchange="setT(this.value)"><option value="bal" ${me.tac=="bal"?"selected":""}>Equilibrado</option><option value="atk" ${me.tac=="atk"?"selected":""}>Ofensivo</option><option value="def" ${me.tac=="def"?"selected":""}>Defensivo</option></select><p class="mut">Força do time: <b>${str(me).toFixed(1)}</b>. Toque em dois jogadores para trocar (titulares: 11 primeiros; fora de posição = −12).</p></div><div class="c">`;me.pl.forEach((p,i)=>{if(i==11)h+=`<h3 style="margin-top:10px">Reservas</h3>`;const bad=i<11&&p.pos!=FM[me.form][i];h+=`<div class="row ${sel===i?"sel":""}" onclick="swap(${i})"><span class="mut" style="width:32px">${i<11?POS[FM[me.form][i]]:POS[p.pos]}</span><span class="n">${p.leg!==undefined?"⭐ ":""}${p.n}<br><small>${p.leg!==undefined?"Lenda":p.age+" anos"} · ${POS[p.pos]}${bad?" ⚠️":""} · ${p.g} gols</small></span><span class="ov">${p.o}</span></div>`});h+=`</div>`}
else if(tab=="tb"){const tt=td===null?me.d:td,tb2=tbl(tt);h+=`<div class="c"><div class="seg"><button class="${tt==0?"":"s"}" onclick="td=0;render()">Série A</button><button class="${tt==1?"":"s"}" onclick="td=1;render()">Série B</button></div></div><div class="c w"><table><tr><th>#</th><th>Clube</th><th>J</th><th>V</th><th>E</th><th>D</th><th>GP</th><th>GC</th><th>SG</th><th>Pts</th></tr>${tb2.map((x,k)=>`<tr class="${x.i==S.me?"me ":""}${tt?(k<4?"z1":""):(k<4?"z1":k<6?"z2":k>15?"z3":"")}"><td>${k+1}</td><td>${crest(S.T[x.i],16)} ${S.T[x.i].n}</td><td>${x.j}</td><td>${x.v}</td><td>${x.e}</td><td>${x.d}</td><td>${x.gp}</td><td>${x.gc}</td><td>${x.gp-x.gc}</td><td><b>${x.p}</b></td></tr>`).join("")}</table><p class="mut">Série A: verde G4, dourado G6, vermelho = 4 últimos (rebaixados para a B). Série B: verde = 4 primeiros (promovidos). Desempate: saldo de gols, gols pró, vitórias.</p></div>`}
else if(tab=="cp"){h+=S.cups.map(c=>`<div class="c"><h3>${c.n} ${c.win!=null?"🏆 "+S.T[c.win].n:""}</h3>${c.win==null?`<div>${c.teams.includes(S.me)?"⭐ Seu clube está na disputa":"Seu clube não está na disputa"}</div><div class="mut">Restam: ${c.teams.map(i=>S.T[i].n).join(", ")}</div><div class="mut">Próxima fase: rodada ${c.at[c.k]}</div>`:""}${c.log.map((l,k)=>`<div style="margin-top:8px"><span class="tag">Fase ${k+1}</span>${l.map(x=>`<div class="mut">${x}</div>`).join("")}</div>`).join("")}</div>`).join("")+`<div class="c mut">Versão simplificada: mata-mata só com clubes brasileiros (Libertadores: 8 melhores da Série A; Sul-Americana: 9º a 16º; Copa do Brasil: 12 da A + 4 da B).</div>`}
else if(tab=="mk"){h+=`<div class="c"><h3>Ingresso: R$ <span id="pv">${S.price}</span></h3><input type="range" min="15" max="120" value="${S.price}" style="width:100%" oninput="pv.textContent=this.value;setP(this.value)"></div><div class="c"><h3>Mercado (renova a cada 6 rodadas)</h3>${S.market.map(p=>`<div class="row"><span class="ov">${p.o}</span><span class="n">${p.n}<br><small>${POS[p.pos]} · ${p.age} anos · ${fm(p.v)}</small></span><button onclick="buy(${p.id})">Comprar</button></div>`).join("")}</div><div class="c"><h3>Vender</h3>${me.pl.map(p=>`<div class="row"><span class="ov">${p.o}</span><span class="n">${p.n}<br><small>${POS[p.pos]} · vale ${fm(p.v*.85)}</small></span>${p.leg!==undefined?`<button class="s" onclick="stash(${p.id})">Guardar</button>`:`<button class="s" onclick="sell(${p.id})">Vender</button>`}</div>`).join("")}</div>`}
else if(tab=="pk"){h+=`<div class="c"><h3>Packs históricos</h3><p><button class="${pk=="98"?"":"s"}" onclick="pk='98';render()">Copa 1998</button> <button class="${pk=="06"?"":"s"}" onclick="pk='06';render()">Copa 2006</button></p><button onclick="openPack()">Abrir pack · 🪙 ${PACKCOST}</button><div class="mut" style="margin-top:8px;font-size:12px">Probabilidades (aplicadas no código): ${RN.map((r,i)=>r+" "+RW[i]+"%").join(" · ")}</div>${reveal?`<div class="grid" style="margin-top:10px">${cardH(reveal)}</div>`:""}</div><div class="c"><h3>Coleção (${S.cards.length})</h3><div class="grid">${S.cards.slice().reverse().map(c=>`<div>${cardH(c)}<button style="width:100%;margin-top:4px" onclick="useCard(${c.cid})">Usar no elenco</button><button class="s" style="width:100%;margin-top:4px" onclick="sellCard(${c.cid})">Vender 🪙${RV[LG[c.id][4]]}</button></div>`).join("")||"<span class='mut'>Nenhuma carta ainda.</span>"}</div><p class="mut">Lendas usadas no elenco saem da coleção; na aba Mercado, use "Guardar" para devolvê-las. Atributos são de exemplo.</p></div>`}
else if(tab=="sv"){h+=`<div class="c"><h3>Saves</h3>`;for(let n=1;n<=3;n++)h+=`<div class="row"><span class="n">Slot ${n} ${has(n)?"":"<small>(vazio)</small>"}</span><button onclick="S.slot=${n};save();render()">Salvar</button> ${has(n)?`<button class="s" onclick="load(${n})">Carregar</button><button class="d" onclick="delSlot(${n})">X</button>`:""}</div>`;h+=`<p class="mut">Salvando no slot ${S.slot}. O progresso é salvo automaticamente a cada rodada.</p><p><button class="s" onclick="doExp()">Exportar JSON</button> <button class="s" onclick="S=null;render()">Menu inicial</button></p>${expo?`<textarea readonly onclick="this.select()">${expo.replace(/</g,"&lt;")}</textarea>`:""}<textarea id="imp" placeholder="Cole um JSON para importar"></textarea><button onclick="doImp()">Importar</button></div><div class="c"><h3>Escudos e jogadores reais</h3><p class="mut">Sem internet nem licença, o jogo usa escudos e elencos de exemplo. Envie você mesmo arquivos autorizados.</p><select id="cs">${S.T.map(t=>`<option value="${t.i}">${t.n}</option>`).join("")}</select> <input type="file" accept="image/*" onchange="upCrest(this)"><p class="mut">Elencos: cole JSON {"Flamengo":[{"n":"Nome","pos":"ATT","o":80,"age":25}]} com pos GK, DEF, MID ou ATT (mín. 18 jogadores, 2 goleiros).</p><textarea id="pj"></textarea><button onclick="impPl()">Importar elencos</button></div>`}
$("#app").innerHTML=h;$("#nav").innerHTML=[["home","🏠","Início"],["sq","📋","Elenco"],["tb","📊","Tabela"],["cp","🏆","Copas"],["mk","💰","Mercado"],["pk","🎴","Packs"],["sv","💾","Saves"]].map(([k,i,l])=>`<button class="${tab==k?"on":""}" onclick="go('${k}')">${i}<br>${l}</button>`).join("")}
render();
</script></body></html>
