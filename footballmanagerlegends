function cupStep(c){if(c.win!=null||S.round!=c.at[c.k])return;c.k++;const t=[...c.teams].sort(()=>Math.random()-.5),nx=[],lg=[];for(let i=0;i<t.length;i+=2){const h=S.T[t[i]],a=S.T[t[i+1]],r=sm(h,a);let w=r.hg>r.ag?h:a;if(r.hg==r.ag)w=Math.random()<.5+(str(h)-str(a))/100?h:a;lg.push(h.n+" "+r.hg+" x "+r.ag+" "+a.n+(r.hg==r.ag?" (pên. "+w.n+")":""));nx.push(w.i);if(t[i]==S.me||t[i+1]==S.me){S.last=r;S.news.unshift(c.n+": "+lg[lg.length-1]);if(w.i==S.me)S.money+=2}}c.log.push(lg);c.teams=nx;if(nx.length==1){c.win=nx[0];if(nx[0]==S.me){S.money+=c.pr;S.coins+=300;S.news.unshift("Campeão da "+c.n+"!")}}}
